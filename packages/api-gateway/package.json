{
  "name": "@nft-data-hub/api-gateway",
  "version": "0.0.1",
  "description": "AI-Native API Gateway for NFT Data Hub (REST + MCP)",
  "license": "MIT",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "clean": "rm -rf ./dist tsconfig.tsbuildinfo",
