    "@types/cors": "^2.8.17",
    "@types/jest": "^29.0.2",
    "@types/supertest": "^2.0.16",
    "jest": "^29.0.3",
    "supertest": "^6.3.3",
    "ts-jest": "^29.0.1",
    "ts-node": "^10.4.0",
    "typescript": "^4.9.5",
    "tsc-watch": "^6.0.4"
  }
}
