# =============================================================================
# NFT Data Hub - Environment Configuration
# =============================================================================

# Chain
CHAIN_ID=1
CHAIN_NAME=mainnet
VERSION=v5

# RPC (Alchemy)
BASE_NETWORK_HTTP_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BASE_NETWORK_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@postgres:5432/nft_data_hub

# Redis
REDIS_URL=redis://redis:6379

# RabbitMQ
RABBIT_HOSTNAME=rabbitmq
RABBIT_USERNAME=guest
RABBIT_PASSWORD=guest
ASSERT_RABBIT_VHOST=1

# OpenSea
OPENSEA_API_KEY=YOUR_OPENSEA_API_KEY
METADATA_INDEXING_METHOD=opensea

# Feature Flags
CATCHUP=1
MASTER=1
DO_BACKGROUND_WORK=1
DO_WEBSOCKET_WORK=1
DO_EVENTS_SYNC_BACKFILL=0
DO_ELASTICSEARCH_WORK=0
DO_KAFKA_WORK=0
DO_KAFKA_STREAM_WORK=0
DO_WEBSOCKET_SERVER_WORK=0
DO_OLD_ORDER_WEBSOCKET_WORK=0
LOCAL_TESTING=0
DISABLE_ORDERS=0

# Admin
ADMIN_API_KEY=change-me
CIPHER_SECRET=11111111111111111111111111111111
FEE_RECIPIENT=0x0000000000000000000000000000000000000000
IMAGE_TAG=dev
PORT=3000
